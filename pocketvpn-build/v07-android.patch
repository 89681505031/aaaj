+    private void handleCloudSetupQr(String contents) {
+        try {
+            JSONObject o = new JSONObject(contents == null ? "" : contents.trim());
+            if (!"pocketvpn-cloud-v1".equals(o.optString("type", ""))) {
+                throw new IllegalArgumentException("Это не QR PocketVPN Server");
+            }
+            String url = normalizeCloudUrl(requireJson(o, "url"));
+            String token = requireJson(o, "token");
+            if (!url.startsWith("https://")) throw new IllegalArgumentException("Нужен HTTPS-адрес");
+            saveCloudSettings(url, token);
+            Toast.makeText(this, "Сервер привязан", Toast.LENGTH_SHORT).show();
+            fetchCloudServers(url, token);
+        } catch (Exception e) {
+            Toast.makeText(this, "QR сервера: " + e.getMessage(), Toast.LENGTH_LONG).show();
+        }
+    }
