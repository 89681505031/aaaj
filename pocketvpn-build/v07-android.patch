+    private void revokeCloudPeer(Profile p) {
+        final String token = loadCloudToken();
+        if (token.isEmpty()) {
+            Toast.makeText(this, "Профиль удалён локально. Код сервера не найден, peer не отозван.", Toast.LENGTH_LONG).show();
+            return;
+        }
+        executor.execute(() -> {
+            HttpURLConnection c = null;
+            try {
+                JSONObject request = new JSONObject();
+                request.put("deviceId", p.cloudDeviceId);
+                request.put("publicKey", p.cloudPublicKey);
+                c = openCloudConnection(p.cloudApiUrl + "/v1/peers/revoke", "POST", token);
+                c.setRequestProperty("Content-Type", "application/json; charset=utf-8");
+                c.setDoOutput(true);
+                try (OutputStream out = c.getOutputStream()) {
+                    out.write(request.toString().getBytes(StandardCharsets.UTF_8));
+                }
+                int code = c.getResponseCode();
+                readHttpBody(c, code);
+                if (code < 200 || code >= 300) throw new IllegalStateException("HTTP " + code);
+                runOnUiThread(() -> Toast.makeText(this, "Серверный peer отозван", Toast.LENGTH_SHORT).show());
+            } catch (Exception e) {
+                runOnUiThread(() -> Toast.makeText(this, "Профиль удалён, но peer на сервере не отозван: " + e.getMessage(), Toast.LENGTH_LONG).show());
+            } finally {
+                if (c != null) c.disconnect();
+            }
+        });
+    }
